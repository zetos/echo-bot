{
  "name": "echo-bot",
  "version": "1.2.0",
  "description": "A discord bot that likes to have the last word.",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build tsconfig.json",
    "deployCmds": "tsx src/deploy-commands.ts",
    "lint": "oxlint",
    "format": "prettier --check ."
  },
  "keywords": [
    "discord",
    "bot",
    "echo"
  ],
  "author": "Zetos Lima",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv-safe": "^9.1.0"
  },
  "devDependencies": {
    "@types/dotenv-safe": "^9.1.0",
    "@types/node": "^24.13.6",
    "@types/ws": "^8.18.1",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
